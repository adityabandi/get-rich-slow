# === REQUIRED ===
# Kalshi API credentials (get from kalshi.com → Settings → API Keys)
KALSHI_API_KEY=your-kalshi-api-key-id
KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nyour-key-here\n-----END RSA PRIVATE KEY-----

# API bearer token for dashboard/CLI access (pick any strong random string)
API_TOKEN=pick-a-strong-random-token

# === SCANNER CONFIG ===
# Start in dry-run mode (no real trades)
DRY_RUN=true

# Min YES price to buy (cents). 88 = buy at 88¢+, collect $1 at settlement
MIN_YES_PRICE=90

# Max cost per bet in cents. With $200 budget, keep this conservative.
# 300 = max $3.00 per bet (buys ~3 contracts at 92¢)
MAX_BET_AMOUNT_CENTS=300

# Poll interval (seconds) - how often to scan Kalshi. Default 30s is fine.
POLL_INTERVAL_SECONDS=30

# === OPTIONAL ===
# SQLite database path (Railway volume mount)
# DATABASE_URL=sqlite:///data/predictions.db

# Dashboard password (if deploying the Next.js dashboard)
# DASHBOARD_PASSWORD=your-dashboard-password

# S3 backup (not needed on Railway — skip this)
# DB_BACKUP_BUCKET=
